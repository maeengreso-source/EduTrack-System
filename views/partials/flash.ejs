<div class="flash-container">

    <% if (success && success.length) { %>
    <div class="alert alert-success d-flex align-items-start shadow-sm" role="alert">

        <i class="bi bi-check-circle-fill me-3 mt-1"></i>

        <div class="flex-grow-1">
            <%= success[0] %>
        </div>

        <button
            type="button"
            class="btn-close ms-3"
            data-bs-dismiss="alert"
            aria-label="Close">
        </button>

    </div>
    <% } %>


    <% if (error && error.length) { %>
    <div class="alert alert-danger d-flex align-items-start shadow-sm" role="alert">

        <i class="bi bi-x-circle-fill me-3 mt-1"></i>

        <div class="flex-grow-1">
            <%= error[0] %>
        </div>

        <button
            type="button"
            class="btn-close ms-3"
            data-bs-dismiss="alert"
            aria-label="Close">
        </button>

    </div>
    <% } %>


    <% if (warning && warning.length) { %>
    <div class="alert alert-warning d-flex align-items-start shadow-sm" role="alert">

        <i class="bi bi-exclamation-triangle-fill me-3 mt-1"></i>

        <div class="flex-grow-1">
            <%= warning[0] %>
        </div>

        <button
            type="button"
            class="btn-close ms-3"
            data-bs-dismiss="alert"
            aria-label="Close">
        </button>

    </div>
    <% } %>


    <% if (info && info.length) { %>
    <div class="alert alert-info d-flex align-items-start shadow-sm" role="alert">

        <i class="bi bi-info-circle-fill me-3 mt-1"></i>

        <div class="flex-grow-1">
            <%= info[0] %>
        </div>

        <button
            type="button"
            class="btn-close ms-3"
            data-bs-dismiss="alert"
            aria-label="Close">
        </button>

    </div>
    <% } %>

</div>