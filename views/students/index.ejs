<style>

/* =====================================
   STUDENT MANAGEMENT
===================================== */

.page-header{

    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:25px;

}


.page-title{

    font-size:24px;
    font-weight:700;
    color:#0f172a;

}


.page-subtitle{

    font-size:14px;
    color:#64748b;

}


/* BUTTON */

.add-btn{

    background:#0f7970;
    color:#fff;
    border:none;

    padding:8px 14px;

    font-size:14px;

    border-radius:6px;

}


.add-btn:hover{

    background:#0b625b;
    color:#fff;

}



/* CARD */

.student-card{

    background:#fff;

    border:1px solid #e5e7eb;

}





/* SEARCH */

.card-header{

    padding:15px;

    background:#fff;

    border-bottom:1px solid #e5e7eb;

}


.search-box{

    position:relative;

}



.search-box i{

    position:absolute;

    left:12px;

    top:50%;

    transform:translateY(-50%);

    color:#94a3b8;

}



.search-box input{

    height:38px;

    padding-left:35px;

}



/* TABLE */


.student-table{

    margin:0;

}


.student-table thead th{

    background:#f8fafc;

    color:#64748b;

    font-size:12px;

    text-transform:uppercase;

    font-weight:600;

    padding:12px;

}



.student-table tbody td{

    padding:12px;

    font-size:14px;

    color:#334155;

    vertical-align:middle;

}



.student-table tbody tr:hover{

    background:#f8fafc;

}



/* STUDENT PROFILE */


.student-info{

    display:flex;

    align-items:center;

    gap:10px;

}


.avatar{

    width:38px;

    height:38px;

    border-radius:50%;

    background:#0f7970;

    color:#fff;

    display:flex;

    justify-content:center;

    align-items:center;

    font-weight:600;

}



.student-name{

    font-weight:600;

    color:#0f172a;

}


.student-id{

    font-size:12px;

    color:#64748b;

}




/* BADGE */


.grade-badge{

    background:#e0f2fe;

    color:#0369a1;

    padding:4px 8px;

    font-size:12px;

}


.status-active{

    background:#dcfce7;

    color:#15803d;

    padding:4px 8px;

    font-size:12px;

}


.status-inactive{

    background:#fee2e2;

    color:#dc2626;

    padding:4px 8px;

    font-size:12px;

}



/* ACTION */


.action-btn{

    width:32px;

    height:32px;

    border:none;

    display:inline-flex;

    align-items:center;

    justify-content:center;

    margin:2px;

}



.view{

    background:#eff6ff;

    color:#2563eb;

}


.edit{

    background:#fffbeb;

    color:#d97706;

}


.delete{

    background:#fef2f2;

    color:#dc2626;

}

/* =====================================
   STUDENT SUMMARY CARDS
===================================== */

.student-summary{

    background:#fff;

    border:1px solid #e5e7eb;

    padding:18px;

    display:flex;

    align-items:center;

    gap:15px;

    height:100px;

}


.summary-icon{

    width:45px;

    height:45px;

    display:flex;

    align-items:center;

    justify-content:center;

    background:#e6fffb;

    color:#0f7970;

    font-size:20px;

}


.summary-label{

    font-size:12px;

    text-transform:uppercase;

    color:#64748b;

    font-weight:600;

}


.summary-number{

    font-size:26px;

    font-weight:700;

    color:#0f172a;

}
/* =====================================
   STUDENT SUMMARY CARDS
===================================== */

.student-summary-card{

    background:#ffffff;

    border:1px solid #e5e7eb;

    padding:20px;

    display:flex;

    align-items:center;

    gap:15px;

    min-height:110px;

    transition:.25s ease;

}


.student-summary-card:hover{

    box-shadow:0 6px 18px rgba(0,0,0,.08);

}



.summary-icon{

    width:50px;

    height:50px;

    display:flex;

    align-items:center;

    justify-content:center;

    background:#e6fffb;

    color:#0f7970;

    font-size:22px;

}



.summary-info{

    display:flex;

    flex-direction:column;

}



.summary-title{

    font-size:12px;

    text-transform:uppercase;

    color:#64748b;

    font-weight:600;

    letter-spacing:.5px;

}



.summary-count{

    font-size:28px;

    font-weight:700;

    color:#0f172a;

    line-height:1.2;

}



.summary-description{

    font-size:12px;

    color:#94a3b8;

}


</style>





<div class="container-fluid">


<!-- HEADER -->

<div class="page-header">


<div>

<h2 class="page-title mb-1">

Student Management

</h2>


<p class="page-subtitle mb-0">

Manage student records and enrollment information.

</p>


</div>




<a href="/students/create"
class="btn add-btn">

<i class="bi bi-person-plus me-2"></i>

Add Student

</a>


</div>







<!-- CARD -->
</div>


<!-- ==============================
     STUDENT SUMMARY CARDS
================================ -->


<div class="row mb-4">


<div class="col-md-3">


<div class="student-summary-card">


<div class="summary-icon">

<i class="bi bi-people-fill"></i>

</div>


<div class="summary-info">


<span class="summary-title">

Total Students

</span>


<span class="summary-count">

<%= students.length %>

</span>


<span class="summary-description">

Registered students

</span>


</div>


</div>


</div>







<div class="col-md-3">


<div class="student-summary-card">


<div class="summary-icon">

<i class="bi bi-person-check-fill"></i>

</div>


<div class="summary-info">


<span class="summary-title">

Active Students

</span>


<span class="summary-count text-success">

<%= students.filter(s=>s.status==="Active").length %>

</span>


<span class="summary-description">

Currently enrolled

</span>


</div>


</div>


</div>







<div class="col-md-3">


<div class="student-summary-card">


<div class="summary-icon">

<i class="bi bi-gender-male"></i>

</div>


<div class="summary-info">


<span class="summary-title">

Male Students

</span>


<span class="summary-count">

<%= students.filter(s=>s.gender==="Male").length %>

</span>


<span class="summary-description">

Male population

</span>


</div>


</div>


</div>








<div class="col-md-3">


<div class="student-summary-card">


<div class="summary-icon">

<i class="bi bi-gender-female"></i>

</div>


<div class="summary-info">


<span class="summary-title">

Female Students

</span>


<span class="summary-count">

<%= students.filter(s=>s.gender==="Female").length %>

</span>


<span class="summary-description">

Female population

</span>


</div>


</div>


</div>



</div>

<div class="student-card">


<div class="card-header">


<div class="search-box col-md-4">


<i class="bi bi-search"></i>


<input
type="text"
class="form-control"
placeholder="Search student...">


</div>


</div>








<div class="table-responsive">


<table class="table table-hover student-table">


<thead>

<tr>


<th width="50">

#

</th>


<th>

Student

</th>


<th>

Gender

</th>


<th>

Grade Level

</th>


<th>

Section

</th>


<th>

Status

</th>


<th>

Enrollment Date

</th>


<th width="150" class="text-center">

Action

</th>


</tr>


</thead>




<tbody>



<% if(students && students.length > 0){ %>



<% students.forEach((s,index)=>{ %>



<tr>


<td>

<%= index + 1 %>

</td>





<td>


<div class="student-info">


<div class="avatar">

<%= s.first_name.charAt(0) %>

</div>


<div>


<div class="student-name">

<%= s.first_name %>

<%= s.last_name %>

</div>


<div class="student-id">

ID: <%= s.student_id %>

</div>


</div>


</div>


</td>





<td>

<%= s.gender %>

</td>





<td>

<span class="grade-badge">

<%= s.grade_level %>

</span>

</td>





<td>

<%= s.section_name %>

</td>





<td>


<% if(s.status==="Active"){ %>


<span class="status-active">

Active

</span>


<% }else{ %>


<span class="status-inactive">

Inactive

</span>


<% } %>


</td>





<td>

<%= s.enrollment_date %>

</td>





<td class="text-center">


<a href="/students/<%=s.id%>"
class="action-btn view">

<i class="bi bi-eye"></i>

</a>



<a href="/students/<%=s.id%>/edit"
class="action-btn edit">

<i class="bi bi-pencil"></i>

</a>




<form action="/students/<%=s.id%>/delete"
method="POST"
style="display:inline;">


<button
class="action-btn delete"
onclick="return confirm('Delete student?')">


<i class="bi bi-trash"></i>


</button>


</form>


</td>


</tr>



<% }) %>



<% }else{ %>



<tr>

<td colspan="8"
class="text-center py-5">

<i class="bi bi-mortarboard fs-1 text-muted"></i>

<p class="mt-2 mb-0">

No students found.

</p>

</td>

</tr>



<% } %>



</tbody>



</table>


</div>


</div>


</div>