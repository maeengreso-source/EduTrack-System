<style>
    /* =====================================
   USER SUMMARY CARDS
===================================== */

.user-summary-card{

    background:#ffffff;

    border:1px solid #e5e7eb;

    min-height:110px;

    padding:18px;

    display:flex;

    align-items:center;

    gap:15px;

    transition:.25s ease;

}


.user-summary-card:hover{

    box-shadow:0 6px 18px rgba(0,0,0,.06);

}



.user-summary-icon{

    width:48px;

    height:48px;

    display:flex;

    align-items:center;

    justify-content:center;

    background:#e6fffb;

    color:#0f7970;

    font-size:22px;

}



.user-summary-content{

    display:flex;

    flex-direction:column;

}



.user-summary-title{

    font-size:12px;

    font-weight:600;

    color:#64748b;

    text-transform:uppercase;

    letter-spacing:.5px;

}



.user-summary-number{

    font-size:28px;

    font-weight:700;

    color:#0f172a;

    line-height:1.2;

}



.user-summary-text{

    font-size:12px;

    color:#94a3b8;

}

/* =====================================
   USER TABLE
===================================== */


.user-panel{

    background:#fff;

    border:1px solid #e5e7eb;

}


/* HEADER / SEARCH */

.user-panel-header{

    padding:15px;

    border-bottom:1px solid #e5e7eb;

}


.user-search{

    position:relative;

}


.user-search i{

    position:absolute;

    left:12px;

    top:50%;

    transform:translateY(-50%);

    color:#94a3b8;

}


.user-search input{

    height:38px;

    padding-left:35px;

    border:1px solid #d1d5db;

}





/* TABLE */

.user-table{

    margin:0;

}



.user-table thead th{

    background:#f8fafc;

    color:#64748b;

    font-size:12px;

    font-weight:600;

    text-transform:uppercase;

    padding:12px;

    border-bottom:1px solid #e5e7eb;

}



.user-table tbody td{

    padding:12px;

    font-size:14px;

    color:#334155;

    vertical-align:middle;

}



.user-table tbody tr:hover{

    background:#f8fafc;

}





/* USER PROFILE */


.user-info{

    display:flex;

    align-items:center;

    gap:10px;

}



.user-avatar{

    width:38px;

    height:38px;

    border-radius:50%;

    background:#0f7970;

    color:#fff;

    display:flex;

    align-items:center;

    justify-content:center;

    font-weight:700;

    font-size:14px;

}



.user-name{

    font-weight:600;

    color:#0f172a;

}



.user-email{

    font-size:12px;

    color:#64748b;

}





/* ROLE */

.role-badge{

    background:#e0f2fe;

    color:#0369a1;

    padding:4px 8px;

    font-size:12px;

}





/* STATUS */


.status-active{

    background:#dcfce7;

    color:#15803d;

    padding:4px 8px;

    font-size:12px;

}


.status-inactive{

    background:#fee2e2;

    color:#dc2626;

    padding:4px 8px;

    font-size:12px;

}





/* ACTION BUTTON */


.user-action{

    width:32px;

    height:32px;

    border:none;

    display:inline-flex;

    align-items:center;

    justify-content:center;

    margin:2px;

}



.user-view{

    background:#eff6ff;

    color:#2563eb;

}



.user-edit{

    background:#fffbeb;

    color:#d97706;

}



.user-delete{

    background:#fef2f2;

    color:#dc2626;

}

</style>

<!-- USER SUMMARY CARDS -->

<div class="row mb-4">


<div class="col-md-3">

<div class="user-summary-card">


<div class="user-summary-icon">

<i class="bi bi-people-fill"></i>

</div>


<div class="user-summary-content">

<span class="user-summary-title">
Total Users
</span>


<span class="user-summary-number">
<%= users.length %>
</span>


<span class="user-summary-text">
Registered accounts
</span>


</div>


</div>

</div>






<div class="col-md-3">

<div class="user-summary-card">


<div class="user-summary-icon">

<i class="bi bi-person-check-fill"></i>

</div>


<div class="user-summary-content">

<span class="user-summary-title">
Active Users
</span>


<span class="user-summary-number text-success">
<%= users.filter(u=>u.status==="Active").length %>
</span>


<span class="user-summary-text">
Currently active
</span>


</div>


</div>

</div>







<div class="col-md-3">

<div class="user-summary-card">


<div class="user-summary-icon">

<i class="bi bi-shield-lock-fill"></i>

</div>


<div class="user-summary-content">

<span class="user-summary-title">
Administrators
</span>


<span class="user-summary-number">
<%= users.filter(u=>u.role_name.includes("Admin")).length %>
</span>


<span class="user-summary-text">
System admins
</span>


</div>


</div>

</div>







<div class="col-md-3">

<div class="user-summary-card">


<div class="user-summary-icon">

<i class="bi bi-person-badge-fill"></i>

</div>


<div class="user-summary-content">

<span class="user-summary-title">
Staff
</span>


<span class="user-summary-number">
<%= users.filter(u=>u.role_name==="Staff").length %>
</span>


<span class="user-summary-text">
System staff
</span>


</div>


</div>

</div>


</div>
<!-- USER TABLE -->

<div class="user-panel">


<div class="user-panel-header">


<div class="user-search col-md-4">


<i class="bi bi-search"></i>


<input 
type="text"
class="form-control"
placeholder="Search users...">


</div>


</div>





<div class="table-responsive">


<table class="table table-hover user-table">


<thead>

<tr>

<th width="50">#</th>

<th>User</th>

<th>Username</th>

<th>Email</th>

<th>Role</th>

<th>Status</th>

<th>Last Login</th>

<th>Created</th>

<th width="130" class="text-center">
Action
</th>


</tr>

</thead>



<tbody>


<% users.forEach((u,index)=>{ %>


<tr>


<td>

<%= index + 1 %>

</td>




<td>


<div class="user-info">


<div class="user-avatar">

<%= u.first_name.charAt(0) %>

</div>



<div>


<div class="user-name">

<%= u.first_name %>
<%= u.last_name %>

</div>


<div class="user-email">

<%= u.email %>

</div>


</div>


</div>


</td>




<td>

<%= u.username %>

</td>




<td>

<%= u.email %>

</td>




<td>


<span class="role-badge">

<%= u.role_name %>

</span>


</td>




<td>


<% if(u.status==="Active"){ %>


<span class="status-active">

Active

</span>


<% }else{ %>


<span class="status-inactive">

Inactive

</span>


<% } %>


</td>





<td>

<%= u.last_login || "Never" %>

</td>




<td>

<%= u.created_at %>

</td>





<td class="text-center">


<a href="/users/<%=u.id%>"
class="user-action user-view">

<i class="bi bi-eye"></i>

</a>



<a href="/users/<%=u.id%>/edit"
class="user-action user-edit">

<i class="bi bi-pencil"></i>

</a>




<form action="/users/<%=u.id%>/delete"
method="POST"
style="display:inline">


<button
class="user-action user-delete"
onclick="return confirm('Delete this user?')">


<i class="bi bi-trash"></i>


</button>


</form>


</td>


</tr>


<% }) %>


</tbody>


</table>


</div>


</div>