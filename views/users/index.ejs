
<%- include("partials/addModal") %>
<%- include("partials/editModal") %>
<%- include("partials/deleteModal") %>



<div class="row g-3 mb-4">
    <!-- Total Users -->
    <div class="col-xl-2 col-lg-4 col-md-6">
        <div class="user-summary-card">

            <div class="user-summary-icon">
                <i class="bi bi-people-fill"></i>
            </div>

            <div class="user-summary-content">

                <span class="user-summary-title">
                    Total Users
                </span>

                <span class="user-summary-number">
                    <%= statistics.totalUsers %>
                </span>

                <span class="user-summary-text">
                    All Registered Users
                </span>

            </div>

        </div>
    </div>

    <!-- Active Accounts -->
    <div class="col-xl-2 col-lg-4 col-md-6">
        <div class="user-summary-card">

            <div class="user-summary-icon">
                <i class="bi bi-person-check-fill"></i>
            </div>

            <div class="user-summary-content">

                <span class="user-summary-title">
                    Active Accounts
                </span>

                <span class="user-summary-number text-success">
                    <%= statistics.activeUsers %>
                </span>

                <span class="user-summary-text">
                    Users With Access
                </span>

            </div>

        </div>
    </div>

    <!-- Inactive Accounts -->
    <div class="col-xl-2 col-lg-4 col-md-6">
        <div class="user-summary-card">

            <div class="user-summary-icon">
                <i class="bi bi-person-x-fill"></i>
            </div>

            <div class="user-summary-content">

                <span class="user-summary-title">
                    Inactive Accounts
                </span>

                <span class="user-summary-number text-danger">
                    <%= statistics.inactiveUsers %>
                </span>

                <span class="user-summary-text">
                    Disabled Users
                </span>

            </div>

        </div>
    </div>

    <!-- Teachers -->
    <div class="col-xl-2 col-lg-4 col-md-6">
        <div class="user-summary-card">

            <div class="user-summary-icon">
                <i class="bi bi-mortarboard-fill"></i>
            </div>

            <div class="user-summary-content">

                <span class="user-summary-title">
                    Teachers
                </span>

                <span class="user-summary-number">
                    <%= statistics.teachers %>
                </span>

                <span class="user-summary-text">
                    Faculty Members
                </span>

            </div>

        </div>
    </div>

    <!-- Students -->
    <div class="col-xl-2 col-lg-4 col-md-6">
        <div class="user-summary-card">

            <div class="user-summary-icon">
                <i class="bi bi-backpack-fill"></i>
            </div>

            <div class="user-summary-content">

                <span class="user-summary-title">
                    Students
                </span>

                <span class="user-summary-number">
                    <%= statistics.students %>
                </span>

                <span class="user-summary-text">
                    Student Accounts
                </span>

            </div>

        </div>
    </div>

    <!-- School Staff -->
    <div class="col-xl-2 col-lg-4 col-md-6">
        <div class="user-summary-card">

            <div class="user-summary-icon">
                <i class="bi bi-building-fill"></i>
            </div>

            <div class="user-summary-content">

                <span class="user-summary-title">
                    School Staff
                </span>

                <span class="user-summary-number">
                    <%= statistics.schoolStaff %>
                </span>

                <span class="user-summary-text">
                    Administrative Staff
                </span>

            </div>

        </div>
    </div>

</div>
<div class="user-panel-header">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h5 class="mb-0 fw-semibold">
            User Management
        </h5>

        <button
            type="button"
            class="btn btn-success"
            data-bs-toggle="modal"
            data-bs-target="#addUserModal">

            <i class="bi bi-plus-lg"></i>
            Add User

        </button>

    </div>

    <form method="GET" action="/users">

        <div class="row g-2">

            <!-- Search -->
            <div class="col-md-4">

                <div class="user-search">

                    <i class="bi bi-search"></i>

                    <input
                        type="text"
                        name="search"
                        class="form-control"
                        placeholder="Search users..."
                        value="<%= search %>">

                </div>

            </div>

            <!-- Role -->
            <div class="col-md-3">

                <select
                    name="role"
                    class="form-select">

                    <option value="">All Roles</option>

                    <option value="Super Administrator"
                        <%= role === "Super Administrator" ? "selected" : "" %>>
                        Super Administrator
                    </option>

                    <option value="Administrator"
                        <%= role === "Administrator" ? "selected" : "" %>>
                        Administrator
                    </option>

                    <option value="Registrar"
                        <%= role === "Registrar" ? "selected" : "" %>>
                        Registrar
                    </option>

                    <option value="Staff"
                        <%= role === "Staff" ? "selected" : "" %>>
                        Staff
                    </option>

                    <option value="Teacher"
                        <%= role === "Teacher" ? "selected" : "" %>>
                        Teacher
                    </option>

                    <option value="Student"
                        <%= role === "Student" ? "selected" : "" %>>
                        Student
                    </option>

                </select>

            </div>

            <!-- Status -->
            <div class="col-md-3">

                <select
                    name="status"
                    class="form-select">

                    <option value="">All Status</option>

                    <option value="Active"
                        <%= status === "Active" ? "selected" : "" %>>
                        Active
                    </option>

                    <option value="Inactive"
                        <%= status === "Inactive" ? "selected" : "" %>>
                        Inactive
                    </option>

                </select>

            </div>

            <!-- Search & Reset -->
            <div class="col-md-2 d-flex gap-2">

                <button
                    type="submit"
                    class="btn btn-success flex-fill">

                    <i class="bi bi-search"></i>

                </button>

                <a
                    href="/users"
                    class="btn btn-outline-secondary">

                    <i class="bi bi-arrow-clockwise"></i>

                </a>

            </div>

        </div>

    </form>

</div>

<!-- Add User Modal -->
<%- include("partials/addModal") %>
<div class="table-responsive">

    <table class="table table-hover user-table">

        <thead>

            <tr>

                <th width="60">#</th>
                <th>User</th>
                <th>Username</th>
                <th>Email</th>
                <th>Role</th>
                <th>Status</th>
                <th>Last Login</th>
                <th>Created</th>
                <th width="150" class="text-center">
                    Actions
                </th>

            </tr>

        </thead>

        <tbody>

            <% if(users.length === 0){ %>
                <tr>
                    <td colspan="9" class="text-center text-muted py-5">
                        <i class="bi bi-people fs-1 d-block mb-2"></i>
                        No users found.
                    </td>
                </tr>
            <% } %>

            <% users.forEach((u,index)=>{ %>

            <tr>

                <!-- Number -->
                <td>

                    <%= ((currentPage - 1) * limit) + index + 1 %>

                </td>

                <!-- User -->
                <td>

                    <div class="user-info">

                        <div class="user-avatar">

                        <img
                            src="<%= (!u.profile_image || u.profile_image === 'default.png' || u.profile_image === 'default-avatar-01.png')
                                ? '/images/default-avatar-02.png'
                                : '/uploads/profiles/' + u.profile_image %>"
                            alt="Profile"
                            class="user-avatar-img">

                        </div>

                        <div>

                            <div class="user-name">

                                <%= u.first_name %>
                                <%= u.last_name %>

                            </div>

                            <div class="user-email">

                    
                    <% if (u.role_name === "Student") { %>

                        <i class="bi bi-mortarboard-fill me-1 text-primary"></i>
                        Student ID:
                        <strong><%= u.student_id %></strong>

                    <% } else { %>

                        <i class="bi bi-person-badge-fill me-1 text-success"></i>
                        Employee ID:
                        <strong><%= u.employee_id %></strong>

                    <% } %>
                                            
                </div>

                        </div>

                    </div>

                </td>

                <!-- Username -->
                <td>

                    <%= u.username %>

                </td>

                <!-- Email -->
                <td>

                    <%= u.email %>

                </td>

                <!-- Role -->
                <td>

                    <span class="role-badge">

                        <%= u.role_name %>

                    </span>

                </td>

                <!-- Status -->
                <td>

                    <% if(u.status === "Active"){ %>

                        <span class="status-active">

                            Active

                        </span>

                    <% }else{ %>

                        <span class="status-inactive">

                            Inactive

                        </span>

                    <% } %>

                </td>

                <!-- Last Login -->
                <td>

                    <% if(u.last_login){ %>

                        <div class="fw-semibold">

                            <%= new Date(u.last_login).toLocaleDateString("en-PH",{
                                year:"numeric",
                                month:"short",
                                day:"2-digit"
                            }) %>

                        </div>

                        <small class="text-muted">

                            <%= new Date(u.last_login).toLocaleTimeString("en-PH",{
                                hour:"2-digit",
                                minute:"2-digit",
                                hour12:true
                            }) %>

                        </small>

                    <% }else{ %>

                        <span class="text-muted">

                            Never

                        </span>

                    <% } %>

                </td>

                <!-- Created -->
                <td>

                    <div class="fw-semibold">

                        <%= new Date(u.created_at).toLocaleDateString("en-PH",{
                            year:"numeric",
                            month:"short",
                            day:"2-digit"
                        }) %>

                    </div>

                    <small class="text-muted">

                        <%= new Date(u.created_at).toLocaleTimeString("en-PH",{
                            hour:"2-digit",
                            minute:"2-digit",
                            hour12:true
                        }) %>

                    </small>

                </td>

                <!-- Actions -->
                <td class="text-center">

                    <div class="d-flex justify-content-center align-items-center gap-1">

                        <!-- View -->
                        <a
                            href="/users/<%= u.id %>"
                            class="user-action user-view"
                            title="View">

                            <i class="bi bi-eye"></i>

                        </a>

                        <!-- Edit -->
                        <a
                            href="/users/<%= u.id %>/edit"
                            class="user-action user-edit"
                            title="Edit">

                            <i class="bi bi-pencil"></i>

                        </a>

                        <!-- Delete -->
                        <% if(u.role_name !== "Super Administrator"){ %>

                        <form
                            action="/users/<%= u.id %>/delete"
                            method="POST"
                            class="d-inline">

                            <button
                                type="submit"
                                class="btn user-action user-delete"
                                title="Delete"
                                onclick="return confirm('Are you sure you want to delete this user?')">

                                <i class="bi bi-trash"></i>

                            </button>

                        </form>

                        <% } %>

                    </div>

                </td>

            </tr>

            <% }) %>

        </tbody>

    </table>

</div>
    <div class="d-flex justify-content-between align-items-center mt-4">
        <small class="text-muted">
            Showing
            <%= ((currentPage - 1) * limit) + 1 %>
            -
            <%= Math.min(currentPage * limit, totalUsers) %>
            of
            <%= totalUsers %>
            users
        </small>
        <nav>
            <ul class="pagination mb-0">
                <% if(currentPage > 1){ %>
                <li class="page-item">
                    <a class="page-link"
                        href="?page=<%= currentPage-1 %>&search=<%= search %>&role=<%= role %>&status=<%= status %>">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>
                <% } %>
                <% for(let i=1;i<=totalPages;i++){ %>
                <li class="page-item <%= currentPage===i ? 'active' : '' %>">
                    <a class="page-link"
                        href="?page=<%= i %>&search=<%= search %>&role=<%= role %>&status=<%= status %>">
                        <%= i %>
                    </a>
                </li>
                <% } %>
                <% if(currentPage < totalPages){ %>
                <li class="page-item">
                    <a class="page-link"
                        href="?page=<%= currentPage+1 %>&search=<%= search %>&role=<%= role %>&status=<%= status %>">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
                <% } %>
            </ul>
        </nav>
    </div>

</div>